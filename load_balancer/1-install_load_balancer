#!/usr/bin/env bash
# Installs HAProxy and balances traffic between web-01 and web-02 with roundrobin
export DEBIAN_FRONTEND=noninteractive
apt-get -y update
apt-get -y install haproxy
cat > /etc/haproxy/haproxy.cfg << 'CONF'
global
    daemon
    maxconn 256

defaults
    mode http
    timeout connect 5000ms
    timeout client 50000ms
    timeout server 50000ms

frontend http-in
    bind *:80
    default_backend web-backend

backend web-backend
    balance roundrobin
    server 7368-web-01 18.171.162.21:80 check
    server 7368-web-02 18.171.164.153:80 check
CONF
if [ -f /etc/default/haproxy ]; then
    sed -i 's/^ENABLED=0/ENABLED=1/' /etc/default/haproxy
fi
service haproxy restart || service haproxy start
