#!/usr/bin/env bash
# Install HAProxy and balance HTTP requests across both web servers.

set -e

apt-get update -y
apt-get install -y haproxy

if grep -q '^ENABLED=' /etc/default/haproxy; then
    sed -i 's/^ENABLED=.*/ENABLED=1/' /etc/default/haproxy
else
    printf '%s\n' 'ENABLED=1' >> /etc/default/haproxy
fi

cat > /etc/haproxy/haproxy.cfg <<'HAPROXY'
global
    log /dev/log local0
    log /dev/log local1 notice
    daemon
    maxconn 4096

defaults
    log global
    mode http
    option httplog
    option dontlognull
    timeout connect 5s
    timeout client 50s
    timeout server 50s

frontend http_front
    bind *:80
    default_backend web_servers

backend web_servers
    balance roundrobin
    server 7368-web-01 18.171.162.21:80 check
    server 7368-web-02 18.171.164.153:80 check
HAPROXY

haproxy -c -f /etc/haproxy/haproxy.cfg
update-rc.d haproxy defaults
service haproxy restart || service haproxy start
