#!/usr/bin/env bash
# Configure Nginx on a new web server and identify it in every response.

set -e

apt-get update -y
apt-get install -y nginx
printf '%s\n' 'Holberton School for the win!' > /var/www/html/index.html
cat > /var/www/html/404.html <<'HTML'
