#!/usr/bin/env bash
# Configure Nginx to run as nginx and listen on port 8080.
set -e
getent group nginx >/dev/null 2>&1 || groupadd -r nginx
id -u nginx >/dev/null 2>&1 || useradd -r -M -g nginx -s /usr/sbin/nologin nginx
if grep -q '^user ' /etc/nginx/nginx.conf; then
	sed -i 's/^user .*/user nginx;/' /etc/nginx/nginx.conf
else
	sed -i '1i user nginx;' /etc/nginx/nginx.conf
fi
sed -i -e 's/listen 80;/listen 8080;/' -e 's/listen 80 /listen 8080 /' -e 's/listen \[::\]:80;/listen [::]:8080;/' -e 's/listen \[::\]:80 /listen [::]:8080 /' /etc/nginx/sites-enabled/default
sed -i 's#^pid .*#pid /tmp/nginx.pid;#' /etc/nginx/nginx.conf
mkdir -p /var/log/nginx
chown -R nginx:nginx /var/log/nginx
service nginx stop || true
pkill -x nginx || true
nginx -t
rm -f /tmp/nginx.pid /run/nginx.pid
su -s /bin/sh -c 'nginx' nginx
sleep 1
ps -u nginx -o user=,comm=
